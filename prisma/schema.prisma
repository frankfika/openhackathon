// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  email     String? @unique // Optional for Web3-only users
  name      String
  role      String // admin, judge
  password  String? // Optional for Web3-only users (hashed)
  avatarUrl String?

  // Web3 fields
  wallets         WalletAddress[]
  primaryWalletId String?         @unique
  isWeb3User      Boolean         @default(false) // Has wallet or registered via wallet

  // Global cross-hackathon stats (only for Web3 users)
  globalPoints       Int @default(0)
  participationCount Int @default(0) // Number of hackathons participated
  judgeCount         Int @default(0) // Number of times served as judge
  awardCount         Int @default(0) // Number of awards won

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments              Assignment[]
  projects                 Project[]
  hackathonMemberships     HackathonJudge[]
  crossHackathonActivities CrossHackathonActivity[]

  @@index([globalPoints])
  @@index([isWeb3User])
  // PERFORMANCE: /api/users, /api/dashboard and role-based joins filter on `role`.
  @@index([role])
}

model Hackathon {
  id                            String   @id @default(uuid())
  title                         String
  tagline                       String
  city                          String?
  startAt                       DateTime
  endAt                         DateTime
  status                        String // draft, upcoming, active, judging, completed
  coverGradient                 String
  submissionSchema              Json? // Stores the form configuration
  leaderboardData               Json? // Admin-curated ranking: [{ projectId, rank, award }]
  leaderboardPublished          Boolean  @default(false)
  docsUrl                       String?
  prizePool                     String?
  submissionSuccessHintText     String?
  submissionSuccessHintImageUrl String?
  judgesPerProject              Int      @default(2)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  projects                 Project[]
  scoringCriteria          ScoringCriterion[]
  judges                   HackathonJudge[]
  activityLogs             ActivityLog[]
  crossHackathonActivities CrossHackathonActivity[]

  @@index([status])
  @@index([startAt])
}

model HackathonJudge {
  id          String    @id @default(uuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([hackathonId, userId])
  @@index([hackathonId])
  @@index([userId])
}

model ScoringCriterion {
  id          String    @id @default(uuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  name        String
  maxScore    Int
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([hackathonId])
}

model Project {
  id          String    @id @default(uuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  submitterEmail String
  submitterName  String?

  title          String
  oneLiner       String
  description    String? // Detailed description (markdown)
  tags           String[]
  demoUrl        String?
  repoUrl        String?
  submissionData Json? // Stores the actual form submission data
  status         String? // draft, submitted

  votes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]

  @@index([hackathonId])
  @@index([hackathonId, status])
  @@index([userId])
}

model Assignment {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  judgeId   String
  judge     User    @relation(fields: [judgeId], references: [id])

  status     String // pending, in_progress, completed
  comment    String?
  totalScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores Score[]

  @@unique([projectId, judgeId])
  @@index([judgeId])
  @@index([status])
}

model Score {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterionId  String
  score        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assignmentId])
  @@index([criterionId])
}

model SiteSetting {
  id                       String   @id @default(uuid())
  key                      String   @unique @default("default")
  siteName                 String   @default("OpenHackathon")
  adminBasePath            String   @default("/admin")
  logoUrl                  String?
  tabTitle                 String   @default("OpenHackathon")
  seoTitle                 String   @default("OpenHackathon")
  seoDescription           String   @default("OpenHackathon - Open source hackathon management platform")
  faviconUrl               String   @default("/favicon.svg")
  showPoweredBy            Boolean  @default(true)
  poweredByText            String   @default("Powered by OpenHackathon")
  poweredByUrl             String   @default("https://openhackathon.dev")
  submissionEmailEnabled   Boolean  @default(false)
  smtpHost                 String?
  smtpPort                 Int      @default(587)
  smtpSecure               Boolean  @default(false)
  smtpUser                 String?
  smtpPassEncrypted        String?
  submissionEmailFrom      String   @default("OpenHackathon <no-reply@localhost>")
  submissionEmailReplyTo   String?
  submissionEmailSubject   String   @default("[{{hackathonTitle}}] Submission Receipt {{receiptId}}")
  submissionEmailTimeoutMs Int      @default(10000)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ActivityLog {
  id          String     @id @default(uuid())
  hackathonId String?
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  // Actor info
  actorId   String? // User ID (null for system actions)
  actorRole String // admin, judge, user, system
  actorName String // Snapshot of name at time of action

  // Action details
  action     String // create, update, delete, submit, assign, unassign, score, etc.
  entityType String // project, assignment, score, hackathon, judge, etc.
  entityId   String? // ID of the affected entity

  // Context
  metadata  Json? // Additional context (e.g., { projectTitle, judgeName, score })
  ipAddress String? // For audit trail

  createdAt DateTime @default(now())

  @@index([hackathonId, createdAt])
  @@index([hackathonId, action])
  @@index([hackathonId, entityType])
  @@index([actorId])
  @@index([entityType, entityId])
}

model AIAssessment {
  id        String   @id @default(uuid())
  projectId String
  type      String // quality_assessment, plagiarism_check, etc.
  result    Json // Stores the AI analysis result
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, type])
  @@index([createdAt])
}

model WalletAddress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address String // Wallet address (checksummed for EVM, base58 for Solana)
  chain   String // Chain identifier: ethereum, polygon, base, solana, etc.
  chainId Int? // EVM chain ID (1, 137, 8453, etc.), null for Solana

  isPrimary  Boolean  @default(false) // Primary wallet marker
  verifiedAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address, chain])
  @@index([userId])
  @@index([address])
}

model CrossHackathonActivity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  activityType String // participated, judged, awarded, won_first, won_second, won_third
  points       Int // Points earned for this activity
  metadata     Json? // Additional info: projectId, rank, award, etc.

  onChainTxHash String? // Optional: on-chain proof transaction hash
  onChainStatus String? // pending, confirmed, failed

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([hackathonId, activityType])
}
