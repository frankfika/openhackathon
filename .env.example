# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/openhackathon?schema=public

# API Server (backend listens on this port; vite proxy forwards /api to it)
PORT=3001
# Generate with: openssl rand -hex 32
# The bundled default is intentionally weak and refuses to start in production.
JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
JWT_EXPIRES_IN_SECONDS=604800
JWT_ISSUER=openhackathon
JWT_AUDIENCE=openhackathon-clients
AUTH_DISABLED=false
# SECURITY: Only set ALLOW_TEST_AUTH_HEADER=1 in CI/e2e. Dev/staging must NOT
# set this — it opts into trusting x-test-role / x-test-user-id headers.
ALLOW_TEST_AUTH_HEADER=

# API security (set CORS_ORIGINS in production)
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL=false
TRUST_PROXY=
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
SUBMISSION_RATE_LIMIT_WINDOW_MS=600000
SUBMISSION_RATE_LIMIT_MAX=30
# SECURITY: AI endpoints are expensive (LLM calls). 30/min per user.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

SUBMISSION_RECEIPT_PREFIX=SUB
SUBMISSION_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUBMISSION_RECEIPT_FROM="OpenHackathon <no-reply@example.com>"
SUBMISSION_RECEIPT_REPLY_TO=
SUBMISSION_RECEIPT_SUBJECT="[{{hackathonTitle}}] Submission Receipt {{receiptId}}"
SUBMISSION_EMAIL_TIMEOUT_MS=10000

# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_BASE_PATH=/admin
# Single-hackathon data model toggle (set to "false" only for legacy multi-event migration)
SINGLE_HACKATHON_MODE=true

# White-label branding
VITE_ORGANIZER_NAME=Acme Corp
VITE_ORGANIZER_LOGO=
VITE_PRIMARY_COLOR=#4F46E5

# Powered-by badge (set to "false" to hide)
VITE_SHOW_POWERED_BY=true

# AI Configuration (Optional - enables AI-powered features)
# Supported providers: claude, openai, local (Ollama)
AI_PROVIDER=claude
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Alternative AI providers:
# For OpenAI: AI_PROVIDER=openai, AI_API_KEY=sk-xxx, AI_MODEL=gpt-4o
# For DeepSeek: AI_PROVIDER=openai, AI_API_KEY=sk-xxx, AI_BASE_URL=https://api.deepseek.com, AI_MODEL=deepseek-chat
# For local Ollama: AI_PROVIDER=local, AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=llama3.1:8b

# Anthropic API Key (legacy, use AI_API_KEY instead)
ANTHROPIC_API_KEY=

# ===== Web3 / Multi-chain identity =====
# Enable wallet login and cross-hackathon points tracking
ENABLE_WEB3_LOGIN=true
# Comma-separated chains accepted for login
SUPPORTED_CHAINS=ethereum,polygon,base,arbitrum,optimism,solana
# Default role assigned to new wallet-only users (judge or admin)
WEB3_DEFAULT_ROLE=user
# Nonce time-to-live in milliseconds (default 5 min)
WEB3_NONCE_TTL_MS=300000
# Frontend: WalletConnect project id (get one free at https://cloud.walletconnect.com)
# SECURITY: leaving this empty disables WalletConnect; the placeholder
# "openhackathon-dev-placeholder" will silently fail QR handshakes.
VITE_WALLETCONNECT_PROJECT_ID=

# Points rules (per cross-hackathon activity)
POINTS_PARTICIPATED=10
POINTS_JUDGED=20
POINTS_AWARDED=50
POINTS_WON_FIRST=200
POINTS_WON_SECOND=150
POINTS_WON_THIRD=100

# ===== On-chain attestation (optional) =====
# When enabled, top-3 wins are recorded on-chain via the HackathonRegistry contract
ENABLE_ONCHAIN_STORAGE=false
# Deployed HackathonRegistry contract address (see scripts/deploy.cjs)
REGISTRY_CONTRACT_ADDRESS=
# Private key of an authorized recorder wallet (funds gas for attestations)
ONCHAIN_PRIVATE_KEY=
# Chain to write attestations to (polygon, base, ethereum, arbitrum, optimism)
ONCHAIN_CHAIN=polygon
# RPC endpoints (used for both attestation and confirmation polling)
RPC_URL_ETHEREUM=
RPC_URL_POLYGON=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=

# ===== Contract deployment (Hardhat, dev only) =====
DEPLOYER_PRIVATE_KEY=
RPC_URL_SEPOLIA=
RPC_URL_BASE_SEPOLIA=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
